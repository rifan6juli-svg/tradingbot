# Salin ke .env lalu isi. Jangan pernah commit file .env (TRD bagian 5).

# --- AI ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Nilai awal ai_models saat seed; setelah itu diatur di S-04 (tabel settings).
ANTHROPIC_MODEL=claude-sonnet-5-5
# Wajib diisi owner.
OPENAI_MODEL=

# --- Kalender ekonomi ---
NEWS_PROVIDER=faireconomy

# --- MetaTrader 5 ---
# Opsional: path terminal64.exe jika MT5 tidak terdeteksi otomatis.
MT5_PATH=

# --- Dashboard lokal ---
# Token untuk aksi tulis (header X-Local-Token). Isi dengan string acak panjang.
DASHBOARD_TOKEN=
DASHBOARD_PORT=8000

# --- Notifikasi Telegram (F-09). Kosong = notifikasi nonaktif. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Mode live ---
# Harus tetap false sampai kriteria demo terpenuhi dan owner menyetujui (TRD bagian 5).
LIVE_ENABLED=false

# --- Database ---
DB_PATH=data/bot.db
